{
  "name": "open-trades-os",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @opentradesos/db generate",
    "db:migrate": "pnpm --filter @opentradesos/db migrate",
    "db:test": "pnpm --filter @opentradesos/db test",
    "db:seed": "pnpm --filter @opentradesos/db seed",
    "lint:fix": "eslint . --fix",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "playwright-core": "^1.63.0",
    "prettier": "^3.4.1",
    "turbo": "^2.3.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "type": "module"
}
