{
  "name": "@opentradesos/mobile",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "bundle": "expo export --platform android --platform ios --output-dir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@opentradesos/field-client": "workspace:*",
    "expo": "~57.0.27",
    "expo-background-task": "~57.0.21",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.20",
    "expo-location": "~57.0.20",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "react": "19.3.0",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@opentradesos/core": "workspace:*",
    "@types/react": "~19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
