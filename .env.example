# ---- Database -------------------------------------------------------------
# Any Postgres 16+. Local docker compose default shown.
# Supabase users: use the session pooler connection string from your project.
DATABASE_URL=postgresql://opentradesos:opentradesos@localhost:5432/opentradesos

# ---- Redis (background jobs) ---------------------------------------------
REDIS_URL=redis://localhost:6379

# ---- Auth -----------------------------------------------------------------
AUTH_SECRET=replace-me-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# ---- Storage (S3 compatible: MinIO, Supabase Storage, R2, S3) ------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=opentradesos
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin

# ---- Payments -------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ---- Communications -------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
RESEND_API_KEY=
SMTP_URL=

# ---- AI agents (Phase 8) --------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
ANTHROPIC_API_KEY=
