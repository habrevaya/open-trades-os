# ---- Database -------------------------------------------------------------
# Any Postgres 16+. Local docker compose default shown.
# Supabase: the transaction pooler (port 6543) for the app, and the session or
# direct connection (port 5432) to run migrations. docs/self-hosting/supabase.md
DATABASE_URL=postgresql://opentradesos:opentradesos@localhost:5432/opentradesos
# Connections per process. Ten suits one server; on a serverless host, where
# every instance opens its own pool, use 2 or 3.
# DATABASE_POOL_MAX=10

# ---- Redis (background jobs) ---------------------------------------------
REDIS_URL=redis://localhost:6379

# ---- Auth -----------------------------------------------------------------
AUTH_SECRET=replace-me-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
# Where this deployment is reached from outside. Webhook signatures are
# computed over it and links the app sends out are built from it.
PUBLIC_URL=http://localhost:3000
# Links sent to customers (estimates, invoices, deposits, tracking) use
# PUBLIC_URL. Set this only if the customer portal is served from another host.
# PORTAL_BASE_URL=

# ---- Operator API (off unless set) ---------------------------------------
# For a deployment that runs several companies. At least 32 characters, or it
# stays off. docs/self-hosting/operator-api.md
OPERATOR_TOKEN=

# ---- Worker ---------------------------------------------------------------
# The worker process uses WORKER_DATABASE_URL, or DATABASE_URL when unset.
# docs/self-hosting/worker.md
# WORKER_DATABASE_URL=postgresql://background:change-me@localhost:5432/opentradesos
# On a host with no long running processes, a scheduler calls
# POST /api/internal/worker/tick with this as a bearer token. At least 32
# characters, or the endpoint stays off.
WORKER_TICK_TOKEN=
# Only when the company's Expo project requires an access token for push
# notices to the field app. Without it the worker sends notices unauthenticated,
# which is Expo's default.
# EXPO_ACCESS_TOKEN=

# ---- Storage (S3 compatible: MinIO, Supabase Storage, R2, S3) ------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=opentradesos
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin

# ---- The dispatch map -----------------------------------------------------
# Raster tiles for the map, {z}/{x}/{y}. Blank uses OpenStreetMap's own tile
# servers, whose usage policy asks for no heavy use: a company with several
# dispatchers points this at a tile service it pays for or runs. The geocoder
# that puts addresses on the map is connected under Settings, Integrations.
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=
MAP_TILE_ATTRIBUTION_URL=

# ---- Payments -------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ---- Ad platforms, analytics and review listings -------------------------
# Seals what Google or Meta hands back when somebody presses "Sign in with
# Google" on Settings, Integrations, so the database holds ciphertext and
# never a usable token. 32 random bytes: `openssl rand -base64 32`. The web
# app and the worker both need the same value. Without it the sign in button
# is refused with the reason, and a refresh token kept in your own secret
# store can be named as the connection's credential instead. Changing it
# means every connected platform has to be signed in to again.
CREDENTIAL_SEALING_KEY=
# The OAuth clients and the Google Ads developer token are kept in your
# secret store under names you choose and type on the settings screen, for
# example GOOGLE_OAUTH_CLIENT={"clientId":"...","clientSecret":"..."}.

# ---- Communications -------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
RESEND_API_KEY=
SMTP_URL=
# The phone assistant's conversations go through the voice relay, a process of
# its own (`pnpm --filter @opentradesos/api voice-relay`). This is the public
# address Twilio reaches it on, wss:// and a host; the web app and the relay
# both need it. Unset, calls sent to the assistant go where it puts callers
# through instead. docs/self-hosting/voice.md.
VOICE_RELAY_URL=
# Where the relay listens, behind whatever terminates TLS. 3300 when unset.
VOICE_RELAY_PORT=

# ---- AI agents (Phase 8) --------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
ANTHROPIC_API_KEY=
